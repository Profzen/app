{
  "expo": {
    "name": "DizzitApp",
    "slug": "dizzitapp-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dizzitup",
    "icon": "./assets/brand/finalLogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dizzitup.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dizzitup.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/brand/dizzitup_logo_cercle_cropped.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/brand/finalLogo.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DizzitUp to use Face ID for secure transactions and login."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": false,
            "extraMavenRepos": [
              "https://jitpack.io"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/dizzitup_logo_cercle.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A2840"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "485a099a-a88c-4405-9211-8abd9429ac31"
      }
    },
    "owner": "dizzitup",
    "description": "DizzitApp V1. Build 59 Beta Test Version"
  }
}
