{
  "expo": {
    "name": "DizzitUp",
    "slug": "dizzitapp-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/brand/dizzitup_logo_cercle.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2840"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dizzitup.app"
    },
    "android": {
      "package": "com.dizzitup.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/brand/dizzitup_logo_cercle_cropped.png"
    },
    "plugins": [
      "expo-font",
      "expo-build-properties",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-splash-screen"
    ]
  }
}
